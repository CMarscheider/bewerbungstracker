# Kopieren nach .env und bei Bedarf anpassen.
POSTGRES_PASSWORD=bewerbungen
APP_PORT=4200
# Token für die Agent-API (/api/agent/*), mind. 32 Zeichen, z. B. `openssl rand -hex 32`. Leer = Agent-API aus.
AGENT_TOKEN=
# Optionales, eingeschränktes Token für die Postfach-Auswertung (Routine R3): darf nur Lebenslauf lesen,
# offene Bewerbungen lesen, Ereignisse/Thread/Vorschläge/verarbeitete Mails schreiben. Mind. 32 Zeichen,
# verschieden von AGENT_TOKEN; braucht ein gesetztes AGENT_TOKEN. Leer = nicht verwendet.
AGENT_TOKEN_MAIL=
# Gmail für Bewerbungsentwürfe (nur gemeinsam setzen; beide leer = keine Entwürfe).
# Der Pi legt per IMAP nur Entwürfe mit PDF-Anhang an und sendet nie.
# App-Passwort unter https://myaccount.google.com/apppasswords erzeugen (erfordert Bestätigung
# in zwei Schritten); Leerzeichen dürfen bleiben.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
