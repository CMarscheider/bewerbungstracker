<!doctype html>
<html lang="{{.Letter.Language}}">
<head>
<meta charset="utf-8">
<title>{{.L.SubjectPrefix}} {{.Letter.PositionTitle}} – {{.Person.Name}}</title>
<style>{{template "styles"}}</style>
<style>
  /* Das Anschreiben ist genau eine A4-Seite; zu langer Text wird abgeschnitten statt umzubrechen. */
  .letter { height: 297mm; overflow: hidden; }
  .letter main { display: flex; flex-direction: column; }
  .letter header { margin-bottom: 12mm; }
  .recipient { margin: 0 0 8mm; font-weight: 700; color: var(--side); }
  .dateline { margin: 0 0 8mm; text-align: right; color: var(--muted); }
  .subject { margin: 0 0 6mm; font-size: 12pt; font-weight: 700; color: var(--side); }
  .body p { margin: 0 0 3.5mm; text-align: justify; hyphens: auto; }
  .closing { margin: 4mm 0 0; }
  .signature { margin: 10mm 0 0; font-weight: 700; color: var(--side); }
  .cv { break-before: page; }
</style>
</head>
<body>
<div class="page letter">
  {{template "aside" .}}

  <main>
    <header>
      <h1>{{.Person.Name}}</h1>
      {{with .Person.Headline}}<p>{{.}}</p>{{end}}
    </header>
    <p class="recipient">{{.Letter.CompanyName}}</p>
    <p class="dateline">{{.Dateline}}</p>
    <p class="subject">{{.L.SubjectPrefix}} {{.Letter.PositionTitle}}</p>
    <div class="body">
      {{range .Paragraphs}}<p>{{range $i, $line := .}}{{if $i}}<br>{{end}}{{$line}}{{end}}</p>
      {{end}}
    </div>
    <p class="closing">{{.L.Closing}}</p>
    <p class="signature">{{.Person.Name}}</p>
  </main>
</div>

<div class="page cv">
  {{template "aside" .}}

  {{template "cv-main" .}}
</div>
</body>
</html>
